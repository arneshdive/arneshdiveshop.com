# Database (Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/arneshdiveshop?sslmode=require"

# Auth
JWT_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Midtrans
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="false"

# Resend (email)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@yourdomain.com"

# Cloudflare R2 — the only image storage. There is no provider switch: a
# choice is what once let a migration script report success while writing
# nowhere, so the alternative was removed rather than defaulted.
#
# Vercel Blob still holds every pre-2026-09-07 original and must never be
# deleted — the catalogue cannot be re-uploaded. Nothing writes to it, nothing
# reads it at render time, and no token is needed: the migration scripts in
# lib/scripts/ read it over its public URLs.
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://file.yourdomain.com"   # Cloudflare R2 custom domain, not pub-*.r2.dev

# Midtrans Public Keys (for frontend)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# RajaOngkir API v2 (Komerce) - Multiple keys for higher daily limits
RAJAONGKIR_API_KEY="your-primary-api-key"
RAJAONGKIR_API_KEY_2="your-secondary-api-key"
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1"
